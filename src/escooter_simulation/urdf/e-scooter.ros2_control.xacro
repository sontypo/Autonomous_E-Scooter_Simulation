<?xml version="1.0"?>
<!--
  ros2_control description for the e-scooter.

  Mapping from the ROS 1 controller stack (config/e-scooter_control.yaml plus
  the <transmission> blocks of the old URDF):

    ROS 1                                                 ROS 2 (this file)
    ================================================      =============================================
    rotational_plate_joint                                 rotational_plate_joint
      effort_controllers/JointEffortController               effort command interface
      (its `pid` key was ignored: JointEffortController       -> effort_controllers/JointGroupEffortController
       is a pass-through forward controller)

    handle_bar_chasis_joint                                handle_bar_chasis_joint
      effort_controllers/JointPositionController             position_pid command interface (Classic)
      pid {p: 100, i: 10, d: 20}                             with pos_kp/pos_ki/pos_kd = 100/10/20, so
                                                             gazebo_ros2_control runs the same PID and
                                                             writes an effort
                                                             -> position_controllers/JointGroupPositionController

    front_wheel_joint                                      front_wheel_joint
      velocity_controllers/JointVelocityController           velocity_pid command interface (Classic)
      gazebo_ros_control/pid_gains {p: 10, i: 2, d: 0.1}      with vel_kp/vel_ki/vel_kd = 10/2/0.1
                                                             -> velocity_controllers/JointGroupVelocityController

    back_wheel_joint                                       back_wheel_joint
      passive (no transmission, no joint_state)              state interfaces only, so it stays passive
                                                             but is now reported in /joint_states and TF

  Ignition's hardware component has no PID-backed command interfaces, so there
  the handle bar uses a plain `position` interface with
  `position_proportional_gain` and the front wheel a plain `velocity` interface.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="escooter_ros2_control" params="sim plate_effort_limit:=500 handlebar_effort_limit:=200">

    <xacro:unless value="${sim == 'none'}">
      <ros2_control name="EScooterSystem" type="system">

        <hardware>
          <xacro:if value="${sim == 'classic'}">
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
          </xacro:if>
          <xacro:if value="${sim == 'ignition'}">
            <plugin>ign_ros2_control/IgnitionSystem</plugin>
          </xacro:if>
        </hardware>

        <!-- ===== Handle bar: steering ===== -->
        <joint name="handle_bar_chasis_joint">
          <xacro:if value="${sim == 'classic'}">
            <command_interface name="position_pid">
              <param name="min">-1.047</param>
              <param name="max">1.047</param>
            </command_interface>
            <!-- PID gains of the ROS 1 effort_controllers/JointPositionController -->
            <param name="pos_kp">400.0</param>
            <param name="pos_ki">20.0</param>
            <param name="pos_kd">40.0</param>
            <param name="pos_max_integral_error">10.0</param>
            <param name="pos_min_integral_error">-10.0</param>
            <param name="pos_antiwindup">true</param>
          </xacro:if>
          <xacro:if value="${sim == 'ignition'}">
            <command_interface name="position">
              <param name="min">-1.047</param>
              <param name="max">1.047</param>
            </command_interface>
            <param name="position_proportional_gain">400.0</param>
          </xacro:if>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <!-- ===== Rotational plate: reaction wheel used by the balancing law ===== -->
        <joint name="rotational_plate_joint">
          <command_interface name="effort">
            <param name="min">-${plate_effort_limit}</param>
            <param name="max">${plate_effort_limit}</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <!-- ===== Front wheel: traction ===== -->
        <joint name="front_wheel_joint">
          <xacro:if value="${sim == 'classic'}">
            <command_interface name="velocity_pid"/>
            <!-- PID gains of the ROS 1 gazebo_ros_control/pid_gains entry -->
            <param name="vel_kp">10.0</param>
            <param name="vel_ki">2.0</param>
            <param name="vel_kd">0.1</param>
            <param name="vel_max_integral_error">10.0</param>
            <param name="vel_min_integral_error">-10.0</param>
            <param name="vel_antiwindup">true</param>
          </xacro:if>
          <xacro:if value="${sim == 'ignition'}">
            <command_interface name="velocity"/>
          </xacro:if>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <!-- ===== Back wheel: passive, published for odometry and TF ===== -->
        <joint name="back_wheel_joint">
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

      </ros2_control>
    </xacro:unless>

  </xacro:macro>

</robot>
