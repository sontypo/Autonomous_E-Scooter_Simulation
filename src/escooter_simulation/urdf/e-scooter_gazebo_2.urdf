<?xml version="1.0" ?>
<robot name="e-scooter" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo reference="base_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="reaction_motor">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="rotational_plate">
    <material>Gazebo/BlackTransparent</material>
  </gazebo>
  <gazebo reference="handle_bar_chasis">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_wheel">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="back_wheel">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <!-- ############################################################################################################### -->
  <!-- ROBOT BASE -->
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.0013251 0.0023477 0.054163"
        rpy="0 0 0" />
      <mass
        value="10.426" />
      <inertia
        ixx="0.013523"
        ixy="-0.0012195"
        ixz="-0.020036"
        iyy="0.16754"
        iyz="-0.00023682"
        izz="0.16201" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.72549 0.35294 0.023529 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Dummy link -->
  <link name="dummy"/>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>

  <!-- ############################################################################################################### -->
  <!-- IMU -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.0254 0.02032 0.071234" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <mesh filename="package://escooter_simulation/meshes/sensors/imu.stl" scale="0.002 0.002 0.002"/>
      </geometry>
    </visual>
  </link>

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <material>Gazebo/Grass</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>imu</topicName>
        <serviceName>imu_service</serviceName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>10.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
        <imu>
          <noise>
            <type>gaussian</type>
            <rate>
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </rate>
            <accel>
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </accel>
          </noise>
        </imu>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- ############################################################################################################### -->
  <!-- REACTION MOTOR -->
  <link
    name="reaction_motor">
    <inertial>
      <origin
        xyz="-0.0 -0.00017192 -0.0"
        rpy="0 0 0" />
      <mass
        value="1.503" />
      <inertia
        ixx="0.0023146"
        ixy="6.1736E-08"
        ixz="-6.7245E-06"
        iyy="0.0013884"
        iyz="-6.6571E-07"
        izz="0.0014609" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/reaction_motor.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/reaction_motor.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="reaction_motor_joint"
    type="fixed">
    <origin
      xyz="0.01433 0.0060846 0.021234"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="reaction_motor" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- ROTATIONAL PLATE -->
  <link
    name="rotational_plate">
    <inertial>
      <origin
        xyz="0.00013241 -8.9892E-06 0.00032107"
        rpy="0 0 0" />
      <mass
        value="1.0895" />
      <!-- Reaction plate spin inertia, about the joint axis.

           The SolidWorks export gave izz = 0.002376 kg.m^2 for a 6.6 cm disc,
           which stores only 0.48 N.m.s at the 200 rad/s speed limit. A reaction
           wheel can do no more than trade that momentum with the body, so the
           balancing controller could right at most 1.9 degrees of lean - less
           than the scooter picks up while settling onto the ground.

           Below keeps the plate's 1.09 kg but redistributes it as a 23 cm rim:
           izz = m*r^2 = 0.06 and transverse = izz/2 = 0.03. That is 12 N.m.s,
           enough to arrest 4.1 rad/s of roll and right about 49 degrees. The
           vehicle mass is unchanged, so WHOLE_BODY_WEIGHT and the PD gains in
           escooter_dynamics/params/escooter.yaml stay as they are. The visual
           mesh is still the exported disc; that is display geometry only. -->
      <inertia
        ixx="0.06"
        ixy="0"
        ixz="0"
        iyy="0.06"
        iyz="0"
        izz="0.12" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/rotational_plate.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.62745 0.62745 0.62745 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/rotational_plate.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="rotational_plate_joint"
    type="continuous">
    <origin
      xyz="0.167493 0 0.121234"
      rpy="-1.5708 -1.5211 -1.5708" />
    <parent
      link="reaction_motor" />
    <child
      link="rotational_plate" />
    <axis
      xyz="0 0 1" />
    <!-- 400 rad/s (3820 rpm) with izz = 0.12 gives the plate 48 N.m.s, against
         the 13.4 needed to pick the scooter up off its side from 55 degrees, so
         it rights itself after a fall instead of lying there. -->
    <limit
      effort="500"
      velocity="400" />
  </joint>

  <transmission name="transmission_1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotational_plate_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_1">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ############################################################################################################### -->
  <!-- HANDLE BAR CHASIS -->
  <link
    name="handle_bar_chasis">
    <inertial>
      <origin
        xyz="0.0 -0.0017558 0.0"
        rpy="0 0 0" />
      <mass
        value="5.0678" />
      <inertia
        ixx="0.029756"
        ixy="1.7396E-05"
        ixz="-0.00042286"
        iyy="0.024469"
        iyz="2.1942E-05"
        izz="0.0089585" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/handle_bar_chasis.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/handle_bar_chasis.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="handle_bar_chasis_joint"
    type="revolute">
    <origin
      xyz="0.48977 0.00 -0.05912345"
      rpy="1.5481234 0.0 -0.0" />
    <parent
      link="base_link" />
    <child
      link="handle_bar_chasis" />
    <axis
      xyz="0 1 0" />
    <!-- 40 N.m saturated the position PID at 23 degrees of error, so once the
         scooter leaned the bicycle's own trail back-drove the bars past the 60
         degree stop - measured at +58.5 degrees against a command of 0 - which
         turned the scooter and pulled it over. -->
    <limit
      lower="-1.047"
      upper="1.047"
      effort="200"
      velocity="10" />
  </joint>

  <transmission name="transmission_2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="handle_bar_chasis_joint">
      <!-- <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface> -->
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_2">
      <!-- <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface> -->
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ############################################################################################################### -->
  <!-- FRONT WHEEL -->
  <link
    name="front_wheel">
    <inertial>
      <origin
        xyz="0.48947 -3.0134E-06 -1.8543E-06"
        rpy="0 0 0" />
      <mass
        value="3.0732" />
      <inertia
        ixx="0.0044381"
        ixy="-2.908E-08"
        ixz="-3.8365E-12"
        iyy="0.004438"
        iyz="-2.1213E-08"
        izz="0.0083252" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/front_wheel.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/front_wheel.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="front_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 -0"
      rpy="0 -0.0012323 0.0038014" />
    <parent
      link="handle_bar_chasis" />
    <child
      link="front_wheel" />
    <axis
      xyz="0 0 1" />
  </joint>

  <transmission name="transmission_3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <!-- <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface> -->
    </joint>
    <actuator name="motor_3">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <!-- <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface> -->
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ############################################################################################################### -->
  <!-- BACK WHEEL -->
  <link
    name="back_wheel">
    <inertial>
      <origin
        xyz="-7.7351E-07 -3.1815E-07 0.00068288"
        rpy="0 0 0" />
      <mass
        value="1.7999" />
      <inertia
        ixx="0.0042488"
        ixy="2.3691E-08"
        ixz="-1.3652E-09"
        iyy="0.0042488"
        iyz="-3.1108E-08"
        izz="0.0079075" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/back_wheel.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://escooter_simulation/meshes/back_wheel.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="back_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.50339 -0.0021853 -0.05931234"
      rpy="1.5302 0 0" />
    <parent
      link="base_link" />
    <child
      link="back_wheel" />
    <axis
      xyz="0 0 1" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- GAZEBO CONTROLLER PLUGIN -->
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
      <robotNamespace>/e_scooter</robotNamespace>
      <publishOdomTF>true</publishOdomTF>
      <alwaysOn>true</alwaysOn>
      <!-- <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame> -->
    </plugin>
  </gazebo>
</robot>