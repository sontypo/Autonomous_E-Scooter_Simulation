<?xml version="1.0" ?>
<!--
  Autonomous e-scooter description.

  Single source of truth for every target: Gazebo Classic 11, Ignition Gazebo
  Fortress, and plain RViz visualisation. The link/joint geometry, inertias and
  joint limits are carried over unchanged from the ROS 1
  `urdf/e-scooter_gazebo_2.urdf`; the simulator-specific parts live in
  e-scooter.gazebo.xacro and e-scooter.ros2_control.xacro.

  Arguments
    sim              classic | ignition | none   (which simulator to target)
    namespace        ROS namespace for the controller manager and controllers
    controllers_file absolute path to the ros2_control YAML
    imu_topic        topic the IMU is published on
    mesh_prefix      URI prefix used for the mesh files
-->
<robot name="e-scooter" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="classic"/>
  <xacro:arg name="namespace" default="/e_scooter"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="imu_topic" default="/imu"/>
  <xacro:arg name="mesh_prefix" default="package://escooter_simulation"/>
  <!-- Reaction plate actuator limits. The defaults are the values the
       SolidWorks export shipped with. The plate only stores
       izz * velocity = 0.00238 * 200 = 0.48 N.m.s of angular momentum,
       which is barely enough to right 1.9 deg of lean on an 18.9 kg
       vehicle, so raising plate_velocity_limit (or the plate inertia) is
       what gives the balancing controller room to work.
       See docs/PORTING.md, "Balancing controller". -->
  <xacro:arg name="plate_effort_limit" default="500"/>
  <!-- Reaction plate spin inertia, about the joint axis.

       The SolidWorks export gave izz = 0.002376 kg.m^2 for a 6.6 cm disc, which
       stores only 0.48 N.m.s at the 200 rad/s speed limit. A reaction wheel can
       do no more than trade that momentum with the body, so the balancing
       controller could right at most 1.9 degrees of lean - less than the
       scooter picks up while settling onto the ground. Both simulators lost it
       within half a second.

       The default below keeps the plate's 1.09 kg but redistributes it as a
       23 cm rim, giving izz = m*r^2 = 0.06 and transverse = izz/2 = 0.03. That
       is 12 N.m.s, enough to arrest 4.1 rad/s of roll and right about 49
       degrees. The vehicle mass is unchanged, so WHOLE_BODY_WEIGHT and the PD
       gains in escooter_dynamics stay as they are.

       Pass plate_spin_inertia:=0.002376 plate_transverse_inertia:=0.0014131 to
       get the exported geometry back. See docs/PORTING.md. -->
  <xacro:arg name="plate_spin_inertia" default="0.06"/>
  <xacro:arg name="plate_transverse_inertia" default="0.03"/>
  <xacro:arg name="plate_velocity_limit" default="200"/>

  <xacro:property name="sim" value="$(arg sim)"/>
  <xacro:property name="namespace" value="$(arg namespace)"/>
  <xacro:property name="controllers_file" value="$(arg controllers_file)"/>
  <xacro:property name="imu_topic" value="$(arg imu_topic)"/>
  <xacro:property name="mesh_prefix" value="$(arg mesh_prefix)"/>
  <xacro:property name="plate_effort_limit" value="$(arg plate_effort_limit)"/>
  <xacro:property name="plate_spin_inertia" value="$(arg plate_spin_inertia)"/>
  <xacro:property name="plate_transverse_inertia" value="$(arg plate_transverse_inertia)"/>
  <xacro:property name="plate_velocity_limit" value="$(arg plate_velocity_limit)"/>

  <!-- ############################################################################################################### -->
  <!-- MATERIALS
       The ROS 1 URDF repeated six anonymous <material name=""> blocks, which
       urdfdom cannot register in the model. They are declared once here and
       referenced by name so RViz and the URDF parser both resolve them. -->
  <material name="escooter_orange">
    <color rgba="0.72549 0.35294 0.023529 1"/>
  </material>
  <material name="escooter_steel">
    <color rgba="0.79216 0.81961 0.92941 1"/>
  </material>
  <material name="escooter_grey">
    <color rgba="0.62745 0.62745 0.62745 1"/>
  </material>

  <!-- ############################################################################################################### -->
  <!-- ROBOT BASE -->
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.0013251 0.0023477 0.054163"
        rpy="0 0 0" />
      <mass
        value="10.426" />
      <inertia
        ixx="0.013523"
        ixy="-0.0012195"
        ixz="-0.020036"
        iyy="0.16754"
        iyz="-0.00023682"
        izz="0.16201" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/base_link.STL" />
      </geometry>
      <material
        name="escooter_orange" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Dummy link -->
  <link name="dummy"/>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>

  <!-- ############################################################################################################### -->
  <!-- IMU -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.0254 0.02032 0.071234" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/meshes/sensors/imu.stl" scale="0.002 0.002 0.002"/>
      </geometry>
    </visual>
  </link>

  <!-- ############################################################################################################### -->
  <!-- REACTION MOTOR -->
  <link
    name="reaction_motor">
    <inertial>
      <origin
        xyz="-0.0 -0.00017192 -0.0"
        rpy="0 0 0" />
      <mass
        value="1.503" />
      <inertia
        ixx="0.0023146"
        ixy="6.1736E-08"
        ixz="-6.7245E-06"
        iyy="0.0013884"
        iyz="-6.6571E-07"
        izz="0.0014609" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/reaction_motor.STL" />
      </geometry>
      <material
        name="escooter_steel" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/reaction_motor.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="reaction_motor_joint"
    type="fixed">
    <origin
      xyz="0.01433 0.0060846 0.021234"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="reaction_motor" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- ROTATIONAL PLATE -->
  <link
    name="rotational_plate">
    <inertial>
      <origin
        xyz="0.00013241 -8.9892E-06 0.00032107"
        rpy="0 0 0" />
      <mass
        value="1.0895" />
      <inertia
        ixx="${plate_transverse_inertia}"
        ixy="0"
        ixz="0"
        iyy="${plate_transverse_inertia}"
        iyz="0"
        izz="${plate_spin_inertia}" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/rotational_plate.STL" />
      </geometry>
      <material
        name="escooter_grey" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/rotational_plate.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="rotational_plate_joint"
    type="continuous">
    <origin
      xyz="0.167493 0 0.121234"
      rpy="-1.5708 -1.5211 -1.5708" />
    <parent
      link="reaction_motor" />
    <child
      link="rotational_plate" />
    <axis
      xyz="0 0 1" />
    <limit
      effort="${plate_effort_limit}"
      velocity="${plate_velocity_limit}" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- HANDLE BAR CHASIS -->
  <link
    name="handle_bar_chasis">
    <inertial>
      <origin
        xyz="0.0 -0.0017558 0.0"
        rpy="0 0 0" />
      <mass
        value="5.0678" />
      <inertia
        ixx="0.029756"
        ixy="1.7396E-05"
        ixz="-0.00042286"
        iyy="0.024469"
        iyz="2.1942E-05"
        izz="0.0089585" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/handle_bar_chasis.STL" />
      </geometry>
      <material
        name="escooter_steel" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/handle_bar_chasis.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="handle_bar_chasis_joint"
    type="revolute">
    <origin
      xyz="0.48977 0.00 -0.05912345"
      rpy="1.5481234 0.0 -0.0" />
    <parent
      link="base_link" />
    <child
      link="handle_bar_chasis" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="-1.047"
      upper="1.047"
      effort="40"
      velocity="10" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- FRONT WHEEL -->
  <link
    name="front_wheel">
    <inertial>
      <origin
        xyz="0.48947 -3.0134E-06 -1.8543E-06"
        rpy="0 0 0" />
      <mass
        value="3.0732" />
      <inertia
        ixx="0.0044381"
        ixy="-2.908E-08"
        ixz="-3.8365E-12"
        iyy="0.004438"
        iyz="-2.1213E-08"
        izz="0.0083252" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/front_wheel.STL" />
      </geometry>
      <material
        name="escooter_steel" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/front_wheel.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="front_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 -0"
      rpy="0 -0.0012323 0.0038014" />
    <parent
      link="handle_bar_chasis" />
    <child
      link="front_wheel" />
    <axis
      xyz="0 0 1" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- BACK WHEEL -->
  <link
    name="back_wheel">
    <inertial>
      <origin
        xyz="-7.7351E-07 -3.1815E-07 0.00068288"
        rpy="0 0 0" />
      <mass
        value="1.7999" />
      <inertia
        ixx="0.0042488"
        ixy="2.3691E-08"
        ixz="-1.3652E-09"
        iyy="0.0042488"
        iyz="-3.1108E-08"
        izz="0.0079075" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/back_wheel.STL" />
      </geometry>
      <material
        name="escooter_steel" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/meshes/back_wheel.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="back_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.50339 -0.0021853 -0.05931234"
      rpy="1.5302 0 0" />
    <parent
      link="base_link" />
    <child
      link="back_wheel" />
    <axis
      xyz="0 0 1" />
  </joint>

  <!-- ############################################################################################################### -->
  <!-- GAZEBO CONTROLLER PLUGIN -->

  <!-- ############################################################################################################### -->
  <!-- SIMULATION -->
  <xacro:include filename="$(find escooter_simulation)/urdf/e-scooter.ros2_control.xacro"/>
  <xacro:include filename="$(find escooter_simulation)/urdf/e-scooter.gazebo.xacro"/>

  <xacro:escooter_ros2_control sim="${sim}" plate_effort_limit="${plate_effort_limit}"/>
  <xacro:escooter_gazebo
    sim="${sim}"
    namespace="${namespace}"
    controllers_file="${controllers_file}"
    imu_topic="${imu_topic}"/>

</robot>
