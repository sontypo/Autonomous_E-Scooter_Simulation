  </material>
  <material name="escooter_grey">
    <color rgba="0.62745 0.62745 0.62745 1" />
  </material>
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0013251 0.0023477 0.054163" />
      <mass value="10.426" />
      <inertia ixx="0.013523" ixy="-0.0012195" ixz="-0.020036" iyy="0.16754" iyz="-0.00023682" izz="0.16201" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://escooter_simulation/meshes/base_link.STL" />
      </geometry>
